{
  "name": "pic-standards",
  "version": "0.1.0",
  "description": "NEPA and Permitting Data and Technology Standard - Schemas and Artifacts",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --config jest.coverage.config.js",
    "lint": "eslint --config .eslintrc.json .",
    "lint:fix": "eslint --config .eslintrc.json . --fix",
    "lint:json": "eslint --config .eslintrc.json \"**/*.json\" --fix",
    "lint:scripts": "eslint --config .eslintrc.json --ext .js,.cjs,.mjs scripts",
    "lint:scripts:fix": "eslint --config .eslintrc.json --ext .js,.cjs,.mjs scripts --fix",
    "validate:schemas": "node scripts/validate-schemas.js --verbose",
    "validate:schemas:quiet": "node scripts/validate-schemas.js",
    "validate:json": "node scripts/validate-json.js --verbose",
    "validate:json:quiet": "node scripts/validate-json.js",
    "validate:yaml": "node scripts/validate-yaml.js --verbose",
    "validate:yaml:quiet": "node scripts/validate-yaml.js",
    "validate:crosswalk": "node scripts/validate-database-crosswalk.js",
    "validate:crosswalk:suggestions": "node scripts/validate-database-crosswalk.js --suggestions",
    "validate:openapi": "node scripts/validate-openapi.js",
    "validate:all": "npm run validate:schemas && npm run validate:json && npm run validate:yaml",
    "validate:json:raw": "node scripts/validate-json-raw.js",
    "validate:yaml:raw": "node scripts/validate-yaml-raw.js",
    "validate:sql-seed": "node scripts/validate-sql-seed.js --sql src/database/seed-v1.2.0.sql --schema src/jsonschema/nepa.schema.json",
    "validate:sql-schema": "node scripts/validate-sql-schema.js --sql src/database/schema-v1.2.0.sql --schema src/jsonschema/nepa.schema.json",
    "tmp:all": "npm run validate:schemas >> /tmp/validate_results.txt 2>&1 && npm run validate:json >> /tmp/validate_results.txt 2>&1 && npm run validate:yaml >> /tmp/validate_results.txt 2>&1 && npm run validate:crosswalk >> /tmp/validate_results.txt 2>&1 && npm run validate:openapi >> /tmp/validate_results.txt 2>&1 && npm run validate:json:raw >> /tmp/validate_results.txt 2>&1 && npm run validate:yaml:raw >> /tmp/validate_results.txt 2>&1 && npm run validate:sql-seed >> /tmp/validate_results.txt 2>&1 && npm run validate:sql-schema >> /tmp/validate_results.txt 2>&1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GSA-TTS/pic-standards.git"
  },
  "keywords": [
    "nepa",
    "standards",
    "schema",
    "json-schema"
  ],
  "author": "",
  "license": "CC0-1.0",
  "bugs": {
    "url": "https://permitting.innovation.gov/contact/"
  },
  "homepage": "https://github.com/GSA-TTS/pic-standards#readme",
  "devDependencies": {
    "@eslint/json": "^0.13.0",
    "jsonc-eslint-parser": "^2.3.0",
    "eslint-plugin-jsonc": "^2.10.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "ajv-keywords": "^5.1.0",
    "csv-parser": "^3.0.0",
    "csv-writer": "^1.6.0",
    "eslint": "^8.57.1",
    "jest": "^29.6.1",
    "js-yaml": "^4.1.1",
    "v8-profiler-next": "^1.9.0",
    "0x": "^5.7.0"
  }
}